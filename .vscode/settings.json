{
    // macOS/Linux with Nix: mkhl.direnv loads .envrc (nix develop) and restarts
    // the extensions so rust-analyzer, CodeLLDB and tasks see its toolchain.
    "direnv.restart.automatic": true,
    "rust-analyzer.cargo.extraEnv": { "CARGO_INCREMENTAL": "0" },
    "terminal.integrated.env.windows": {
        "PATH": "${workspaceFolder}\\.compiler-cache\\bin;${env:PATH}",
        "CARGO_INCREMENTAL": "0"
    },
    "terminal.integrated.env.osx": {
        "PATH": "${workspaceFolder}/.compiler-cache/bin:${env:PATH}",
        "CARGO_INCREMENTAL": "0"
    },
    "terminal.integrated.env.linux": {
        "PATH": "${workspaceFolder}/.compiler-cache/bin:${env:PATH}",
        "CARGO_INCREMENTAL": "0"
    }
}
