# direnv + nix-direnv: loads `nix develop .#default` on entering the clone
# (terminal or VS Code with the mkhl.direnv extension). The evaluated shell is
# cached in .direnv/ and kept as a GC root: reopening the project is instant
# and `nix-collect-garbage` does not drop the toolchain, Dioxus or Jackdaw.
# First use: `direnv allow`. Reload by hand with `direnv reload`.
if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" \
    "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi

# Personal overrides (e.g. PARKOUR_OVH_PULL=0, AWS_PROFILE), never committed.
source_env_if_exists .envrc.local

# flake.nix and flake.lock are watched by nix-direnv; these inputs also change
# the shell (toolchain, pinned tools, CLI lockfiles).
nix_inputs="rust-toolchain.toml nix/*.nix nix/cli-locks/*.lock tools/xtask/tools.lock.json"
# shellcheck disable=SC2086
watch_file $nix_inputs

# Before nix-direnv builds a new shell, fetch what CI already compiled (Dioxus,
# Jackdaw, toolchains...) from the private OVH cache, read-only, with your
# Infisical login. Once per change of the Nix inputs; failures only fall back
# to cache.nixos.org and local builds. Retry: rm .direnv/ovh-pull-*.
if [ "${PARKOUR_OVH_PULL:-1}" != 0 ]; then
  # shellcheck disable=SC2086
  inputs_id=$(cat flake.nix flake.lock $nix_inputs | git hash-object --stdin)
  if [ ! -e ".direnv/ovh-pull-$inputs_id" ]; then
    mkdir -p .direnv
    log_status "pulling the dev shell inputs from the OVH Nix cache (PARKOUR_OVH_PULL=0 disables)"
    system=$(nix eval --raw --impure --expr builtins.currentSystem)
    if nix run .#nix-cache -- pull --inputs ".#devShells.$system.default" >&2; then
      log_status "OVH Nix cache pull done"
    else
      log_error "OVH Nix cache unavailable (infisical login --domain https://eu.infisical.com ?); building normally"
    fi
    rm -f .direnv/ovh-pull-*
    touch ".direnv/ovh-pull-$inputs_id"
  fi
fi

use flake .#default
